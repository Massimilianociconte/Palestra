<?xml version="1.0" encoding="utf-8"?>
<!--
  P2.26 — Data extraction rules for Android 12+ (API 31+).
  Split backup into "cloud" (Auto Backup) and "device" (D2D transfer).
  We deny both for sensitive Capacitor/WebView data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" path="app_webview/" />
        <exclude domain="file" path="app_webview_test/" />
        <exclude domain="file" path="app_CapacitorPreferences/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="no_backup/" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" path="app_webview/" />
        <exclude domain="file" path="app_CapacitorPreferences/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
